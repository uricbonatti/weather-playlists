  "author": "Uric Bonatti <uricbonatti.eng@gmail.com>",
  "license": "MIT",
  "scripts": {
    "build": "tsc --project tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/app/server.js",
    "start:dev": "ts-node-dev -r tsconfig-paths/register -r dotenv/config --transpile-only --ignore-watch node_modules src/app/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "jest --selectProjects unit",
    "test:e2e": "jest --selectProjects e2e --runInBand",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/redis": "^11.14.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/spotify-web-api-node": "^5.0.11",
    "@types/supertest": "^6.0.3",
    "dotenv": "^16.6.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "ioredis-mock": "^8.13.1",
    "jest": "^29.7.0",
    "mock-express-request": "^0.2.2",
    "mock-express-response": "^0.3.0",
    "nock": "^14.0.17",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "testcontainers": "^11.14.0",
    "ts-jest": "^29.4.14",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.9.7",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "axios": "^1.20.0",
    "celebrate": "^15.0.3",
    "cors": "^2.8.6",
