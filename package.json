    "express-async-errors": "^3.1.1",
    "express-prom-bundle": "^7.0.2",
    "express-rate-limit": "^7.5.1",
    "ioredis": "^5.11.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "spotify-web-api-node": "^5.0.2",
    "tsyringe": "^4.10.0",
    "winston": "^3.19.0"
  }
